# Copy to .env.local for local dev; set the same names in Vercel > Settings > Environment Variables.
# Never commit real values. See docs/PAYMENTS.md.

# --- Required for payments (PayFast) ---
# 'live' charges real money; anything else is sandbox.
PAYFAST_ENV=sandbox
# Sandbox values come from your own free PayFast sandbox account (the shared 10000100 merchant rejects signatures).
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
# Live values (only used when PAYFAST_ENV=live). The merchant key is 13 characters.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Random 32+ char string used to sign entitlement tokens.
ENTITLEMENT_SECRET=
# Supabase project "wts-compoundiq-billing"
SUPABASE_URL=
# Project Settings > API Keys > service_role (secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used for PayFast return/notify links, e.g. https://wtscompoundiq.vercel.app
PUBLIC_BASE_URL=

# --- Optional ---
# Email-a-backup feature (api/backup/email.js)
RESEND_API_KEY=
EMAIL_FROM=
# Legacy Paystack path (only used when PayFast is not fully configured)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
